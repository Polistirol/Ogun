# Copy this file to .env and fill in the values:
#   cp .env.example .env          # Linux/macOS
#   copy .env.example .env        # Windows
# .env must not be committed (it is in .gitignore).

# Required when LLM_PROVIDER=anthropic (default)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: raises the GitHub rate limit from 60 to 5000 requests/hour
GITHUB_TOKEN=

# DeepSeek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional: 1 to enable V4 thinking (default off: we need JSON, not reasoning)
# DEEPSEEK_THINKING=0

# LLM provider: anthropic (default) or lmstudio [anthropic | lmstudio | deepseek]
LLM_PROVIDER=lmstudio

# Used only when LLM_PROVIDER=lmstudio
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen3-14b
